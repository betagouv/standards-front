- content_for(:column_overrides) { "lg: 10, md: 12" }
- content_for(:page_title) { "Évaluation de #{@startup.name}"}

%h1
  Évaluation de
  = @evaluation.startup.name

%hr

- @evaluation.questions.group_by(&:category).each do |category, questions|
  %h2= t("evaluations.categories.#{category}.label")
  %ul
    - questions.each do |question|
      %li.fr-my-2w
        %strong= question.title
        %ul
          - question.criteria.each do |criterion|
            %li
              = criterion.label.delete_suffix(".")
              = badge_for_answer(criterion.answer)
